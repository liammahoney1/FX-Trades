"""
FX Trade Exception Investigation & Epic Scoping Engine
-------------------------------------------------------
Analyzes failed/delayed institutional FX trades, identifies high-impact
exception patterns, separates facts from assumptions, and surfaces
control/entitlement constraints.

NOTE: This code contains several intentional bugs for investigation purposes.
"""

import datetime
from collections import defaultdict
from enum import Enum
from typing import Optional


class TradeStatus(Enum):
    SETTLED = "settled"
    FAILED = "failed"
    DELAYED = "delayed"
    PENDING = "pending"
    CANCELLED = "cancelled"


class ExceptionCategory(Enum):
    SSI_MISMATCH = "ssi_mismatch"
    FUNDING_SHORTFALL = "funding_shortfall"
    CLS_CUTOFF_MISSED = "cls_cutoff_missed"
    NETTING_BREAK = "netting_break"
    COUNTERPARTY_UNCONFIRMED = "counterparty_unconfirmed"
    ENTITLEMENT_BLOCK = "entitlement_block"
    REGULATORY_HOLD = "regulatory_hold"


# --- BUG #1: Off-by-one in SLA calculation ---
def calculate_sla_breach(trade_timestamp: datetime.datetime, sla_hours: int = 4) -> bool:
    """Determine if a trade has breached its investigation SLA."""
    now = datetime.datetime.utcnow()
    elapsed = now - trade_timestamp
    # Bug: should be >= not > (trades exactly at SLA boundary slip through)
    return elapsed.total_seconds() > sla_hours * 60 * 60


# --- BUG #2: Silent None propagation ---
def get_counterparty_ssi(counterparty_id: str, currency_pair: str) -> dict:
    """Fetch standing settlement instructions for a counterparty."""
    ssi_registry = {
        "CP001": {"EUR/USD": {"nostro": "DEUTDEFF", "correspondent": "CHASUS33"}},
        "CP002": {"GBP/USD": {"nostro": "BARCGB22", "correspondent": "CITIUS33"}},
        "CP003": {"USD/JPY": {"nostro": "MHCBJPJT", "correspondent": "CHASUS33"}},
    }
    # Bug: returns None if counterparty or pair not found, callers don't check
    return ssi_registry.get(counterparty_id, {}).get(currency_pair)


def validate_settlement_instructions(trade: dict) -> dict:
    """Validate SSI match between trade and counterparty records."""
    ssi = get_counterparty_ssi(trade["counterparty_id"], trade["currency_pair"])
    # Bug: will throw TypeError when ssi is None (no null check)
    result = {
        "nostro_match": ssi["nostro"] == trade.get("nostro_account"),
        "correspondent_match": ssi["correspondent"] == trade.get("correspondent_bank"),
        "validated": True
    }
    return result


# --- BUG #3: Incorrect priority scoring (division logic) ---
class ExceptionPriorityScorer:
    """Scores exceptions by impact to determine investigation order."""

    WEIGHT_MAP = {
        ExceptionCategory.SSI_MISMATCH: 8,
        ExceptionCategory.FUNDING_SHORTFALL: 9,
        ExceptionCategory.CLS_CUTOFF_MISSED: 10,
        ExceptionCategory.NETTING_BREAK: 7,
        ExceptionCategory.COUNTERPARTY_UNCONFIRMED: 5,
        ExceptionCategory.ENTITLEMENT_BLOCK: 6,
        ExceptionCategory.REGULATORY_HOLD: 10,
    }

    def calculate_priority(self, category: ExceptionCategory, notional_usd: float,
                           client_tier: str, hours_outstanding: float) -> float:
        """Calculate composite priority score for an exception."""
        base_weight = self.WEIGHT_MAP.get(category, 5)
        tier_multiplier = {"platinum": 3.0, "gold": 2.0, "silver": 1.5, "bronze": 1.0}

        # Bug: KeyError if client_tier not in map (no .get() with default)
        multiplier = tier_multiplier[client_tier]

        # Bug: integer division truncates score for small notionals
        notional_factor = notional_usd / 1000000

        # Bug: hours_outstanding of 0 causes ZeroDivisionError
        urgency = 100 / hours_outstanding

        return base_weight * multiplier * notional_factor * urgency


# --- BUG #4: Race condition in shared state / stale cache ---
class InvestigationTracker:
    """Tracks active investigations and their outcomes."""

    _instance = None
    _cache = {}

    def __new__(cls):
        if cls._instance is None:
            cls._instance = super().__new__(cls)
            cls._instance.investigations = {}
        return cls._instance

    def add_investigation(self, trade_id: str, analyst: str, category: ExceptionCategory):
        # Bug: no lock, concurrent adds can overwrite each other
        self.investigations[trade_id] = {
            "analyst": analyst,
            "category": category,
            "started_at": datetime.datetime.utcnow(),
            "status": "open",
        }

    def get_analyst_workload(self, analyst: str) -> int:
        count = 0
        for trade_id, inv in self.investigations.items():
            # Bug: "open" vs "Closed" case mismatch means closed investigations still count
            if inv["analyst"] == analyst and inv["status"] != "Closed":
                count += 1
        return count

    def close_investigation(self, trade_id: str, resolution: str):
        if trade_id in self.investigations:
            self.investigations[trade_id]["status"] = "Closed"  # Bug: capitalized


# --- BUG #5: Incorrect date windowing ---
def analyze_exception_patterns(trades: list[dict], lookback_days: int = 30) -> dict:
    """Identify highest-impact exception patterns from trade history."""
    cutoff = datetime.datetime.utcnow() - datetime.timedelta(days=lookback_days)

    pattern_stats = defaultdict(lambda: {
        "count": 0, "total_notional": 0.0,
        "avg_resolution_hours": 0.0, "affected_clients": set(),
    })

    for trade in trades:
        trade_date = datetime.datetime.fromisoformat(trade["trade_date"])
        # Bug: comparison is BACKWARDS - includes trades OUTSIDE the window
        if trade_date < cutoff:
            category = trade.get("exception_category")
            if category:
                stats = pattern_stats[category]
                stats["count"] += 1
                stats["total_notional"] += trade.get("notional_usd", 0)
                stats["affected_clients"].add(trade.get("client_id"))

                # Bug: overwrites avg instead of computing running average
                if trade.get("resolution_hours"):
                    stats["avg_resolution_hours"] = trade["resolution_hours"]

    ranked = sorted(
        pattern_stats.items(),
        key=lambda x: x[1]["count"] * x[1]["total_notional"],
        reverse=True
    )
    return {"patterns": ranked, "total_exceptions": sum(s["count"] for _, s in ranked)}


# --- BUG #6: Facts vs assumptions classifier ---
class EvidenceClassifier:
    """Separates hard evidence (facts) from assumptions/hypotheses."""

    FACT_SOURCES = ["swift_message", "cls_confirmation", "nostro_statement",
                    "trade_blotter", "regulatory_filing"]

    def classify(self, evidence_items: list[dict]) -> dict:
        facts, assumptions = [], []

        for item in evidence_items:
            source = item.get("source", "").lower()
            # Bug: substring match causes false positives
            # "swift_message_draft" matches "swift_message"
            is_fact = any(fact_src in source for fact_src in self.FACT_SOURCES)

            if is_fact:
                facts.append({"content": item["content"], "confidence": 1.0})
            else:
                assumptions.append({"content": item["content"], "confidence": 0.5})

        return {
            "facts": facts,
            "assumptions": assumptions,
            # Bug: ZeroDivisionError if evidence_items is empty
            "fact_ratio": len(facts) / len(evidence_items),
        }


# --- BUG #7: Entitlement check has wrong key name ---
class ComplianceGate:
    """Surfaces control and entitlement constraints."""

    RESTRICTED_PAIRS = ["USD/RUB", "USD/CNH", "EUR/RUB"]
    MAX_MANUAL_OVERRIDE_USD = 50_000_000

    def __init__(self, user_entitlements: dict):
        self.entitlements = user_entitlements

    def can_resolve(self, trade: dict, resolution_action: str) -> dict:
        blocks = []

        if trade["currency_pair"] in self.RESTRICTED_PAIRS:
            # Bug: checks "restricted_pairs" but entitlements dict uses "restricted_currency"
            if not self.entitlements.get("restricted_pairs"):
                blocks.append("RESTRICTED_CURRENCY: Requires clearance")

        if trade.get("notional_usd", 0) > self.MAX_MANUAL_OVERRIDE_USD:
            if "senior_ops" not in self.entitlements.get("roles", []):
                blocks.append("NOTIONAL_LIMIT: Exceeds manual override threshold")

        if resolution_action == "manual_release":
            # Bug: checks approver exists but not approver != resolver (four-eyes broken)
            if not trade.get("approver_id"):
                blocks.append("FOUR_EYES: Requires secondary approval")

        # Bug: missing market-hours check entirely

        return {"permitted": len(blocks) == 0, "blocks": blocks}


# --- BUG #8: Netting break detection with float comparison ---
def detect_netting_breaks(settlement_batch: list[dict]) -> list[dict]:
    netting_groups = defaultdict(lambda: {"pay": 0.0, "receive": 0.0, "trades": []})

    for trade in settlement_batch:
        key = (trade["counterparty_id"], trade["currency_pair"], trade["value_date"])
        group = netting_groups[key]
        group["trades"].append(trade["trade_id"])

        if trade["side"] == "buy":
            group["receive"] += trade["notional"]
        elif trade["side"] == "sell":
            group["pay"] += trade["notional"]
        # Bug: swap legs ("both" side) silently dropped

    breaks = []
    for key, group in netting_groups.items():
        net = group["receive"] - group["pay"]
        # Bug: floating point == comparison without epsilon tolerance
        if net != 0:
            breaks.append({"counterparty": key[0], "net_amount": net})

    return breaks


# --- BUG #9: Epic scoping miscalculation ---
def scope_epic_impact(exception_history: list[dict], ops_team_size: int = 12) -> dict:
    total_manual_hours = 0
    total_failed_notional = 0
    penalty_costs = 0

    for exc in exception_history:
        total_manual_hours += exc.get("investigation_hours", 0)
        total_failed_notional += exc.get("notional_usd", 0)

        if exc.get("status") == "failed":
            # Bug: notional_usd could be None, causing TypeError in multiplication
            penalty_costs += exc.get("penalty_bps", 0) * exc.get("notional_usd") / 10000

    # Bug: ops_team_size of 0 = ZeroDivisionError
    avg_hours_per_analyst = total_manual_hours / ops_team_size

    # Bug: assumes 30-day input period (magic number), data could span any period
    annual_projection = {
        "manual_hours_saved": total_manual_hours * (252 / 30),
        "penalty_savings": penalty_costs * (252 / 30),
    }

    return {"current_state": {"total_manual_hours": total_manual_hours}, "projected": annual_projection}


# --- Main pipeline ---
def run_investigation_pipeline(trade_data: dict, evidence: list[dict],
                                user_entitlements: dict) -> dict:
    results = {}
    results["ssi_validation"] = validate_settlement_instructions(trade_data)

    classifier = EvidenceClassifier()
    results["evidence"] = classifier.classify(evidence)

    scorer = ExceptionPriorityScorer()
    results["priority_score"] = scorer.calculate_priority(
        category=ExceptionCategory(trade_data.get("exception_category", "ssi_mismatch")),
        notional_usd=trade_data.get("notional_usd", 0),
        client_tier=trade_data.get("client_tier", "silver"),
        hours_outstanding=trade_data.get("hours_outstanding", 0)  # Bug: default 0 = ZeroDivision
    )

    gate = ComplianceGate(user_entitlements)
    results["compliance"] = gate.can_resolve(trade_data, "manual_release")

    # Bug: no try/except, any step failure crashes the whole pipeline
    return results
